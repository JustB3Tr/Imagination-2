# Copy to paths.env or export in Colab shell.
# Monorepo root (folder that contains versions/ and scripts/)
IMAGINATION_REPO_ROOT=/content/imagination-v1.1.0

# HF causal LM used as Imagination 2 base (must contain config.json)
IMAGINATION2_BASE_MODEL=/content/drive/MyDrive/models/my-base-model

# Optional: vision bundle for CLIP+projector inference (projector.pt + attach_vision_multimodal_meta.json)
IMAGINATION_VISION_PROJECTOR_DIR=/content/imagination-v1.1.0/versions/v1.4/training/outputs/vision_projector

# Hugging Face token if you use gated datasets
# HF_TOKEN=
